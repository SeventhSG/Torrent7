<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Torrent7.Controls"
        x:Class="Torrent7.Views.AddLinkWindow"
        Title="Add a link"
        Icon="avares://Torrent7/Assets/Torrent7.ico"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <StackPanel Margin="24,20,24,20" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <c:StrokeIcon Data="{StaticResource IconMagnet}" Width="18" Height="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Classes="title" FontSize="17" Text="Add a magnet link or web link" />
        </StackPanel>
        <TextBlock Classes="dim" TextWrapping="Wrap"
                   Text="Paste a magnet link, an info hash, or a link to a .torrent file. Put several on separate lines to add them all." />
        <TextBox x:Name="LinkBox" AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalContentAlignment="Top"
                 Watermark="magnet:?xt=urn:btih:..." FontFamily="{StaticResource MonoFont}" FontSize="12" />
        <TextBlock x:Name="Problem" Classes="caption" Text=" " />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="tool" Content="Cancel" Click="OnCancel" IsCancel="True" />
            <Button x:Name="AddButton" Classes="accent" Content="Continue" Click="OnAdd" IsDefault="True" Padding="18,0" />
        </StackPanel>
    </StackPanel>
</Window>
