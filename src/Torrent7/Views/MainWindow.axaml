<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Torrent7.ViewModels"
        xmlns:c="using:Torrent7.Controls"
        xmlns:v="using:Torrent7.Views"
        x:Class="Torrent7.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Torrent7"
        Icon="avares://Torrent7/Assets/Torrent7.ico"
        Width="1240" Height="780" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="46"
        DragDrop.AllowDrop="True">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding AddFilesCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding AddLinkCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddLinkCommand}" />
        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedCommand}" />
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding OpenFolderSelectedCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Narrow windows: the toolbar keeps its icons and drops its words. -->
        <Style Selector="Border.compact Button.tool StackPanel > TextBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="46,*,28" ColumnDefinitions="232,*">

        <!-- Title bar, left: the app, over the sidebar -->
        <Border Grid.Row="0" Grid.Column="0" x:Name="TitleLeft" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <c:AppMark Width="22" Height="22" />
                <TextBlock Text="Torrent7" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Title bar, right: the toolbar -->
        <Border Grid.Row="0" Grid.Column="1" x:Name="TitleRight" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,0,0,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="accent" Padding="10,0,8,0" AutomationProperties.Name="Add" ToolTip.Tip="Add a torrent (Ctrl+O, Ctrl+L, or Ctrl+V)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:StrokeIcon Data="{StaticResource IconPlus}" Width="15" Height="15" />
                            <TextBlock Text="Add" VerticalAlignment="Center" />
                            <c:StrokeIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12" Margin="2,1,0,0" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Torrent file..." InputGesture="Ctrl+O" Command="{Binding AddFilesCommand}">
                                    <MenuItem.Icon><c:StrokeIcon Data="{StaticResource IconFile}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Magnet link or web link..." InputGesture="Ctrl+L" Command="{Binding AddLinkCommand}">
                                    <MenuItem.Icon><c:StrokeIcon Data="{StaticResource IconMagnet}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Paste from clipboard" InputGesture="Ctrl+V" Command="{Binding PasteCommand}">
                                    <MenuItem.Icon><c:StrokeIcon Data="{StaticResource IconClipboard}" /></MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="14,0,0,0" VerticalAlignment="Center"
                            IsVisible="{Binding IsTransfers}">
                    <Border Classes="vline" Height="20" Margin="0,0,10,0" />
                    <Button Classes="tool" Command="{Binding ResumeSelectedCommand}" AutomationProperties.Name="Resume" ToolTip.Tip="Resume">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:StrokeIcon Data="{StaticResource IconPlay}" Width="15" Height="15" />
                            <TextBlock Text="Resume" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding PauseSelectedCommand}" AutomationProperties.Name="Pause" ToolTip.Tip="Pause">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:StrokeIcon Data="{StaticResource IconPause}" Width="15" Height="15" />
                            <TextBlock Text="Pause" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding RemoveSelectedCommand}" AutomationProperties.Name="Remove" ToolTip.Tip="Remove (Delete)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:StrokeIcon Data="{StaticResource IconTrash}" Width="15" Height="15" />
                            <TextBlock Text="Remove" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Classes="vline" Height="20" Margin="8,0" />
                    <Button Classes="tool square" Command="{Binding OpenFolderSelectedCommand}" AutomationProperties.Name="Open folder" ToolTip.Tip="Open folder (Ctrl+Enter)">
                        <c:StrokeIcon Data="{StaticResource IconFolderOpen}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="tool square" AutomationProperties.Name="More actions" ToolTip.Tip="More" IsEnabled="{Binding HasSelection}">
                        <c:StrokeIcon Data="{StaticResource IconDots}" Width="16" Height="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Start now, skip the queue" Command="{Binding ForceStartSelectedCommand}" />
                                <MenuItem Header="Download in order" Command="{Binding ToggleSequentialCommand}" IsEnabled="{Binding ShowDetails}" />
                                <Separator />
                                <MenuItem Header="Move files to..." Command="{Binding MoveSelectedCommand}" IsEnabled="{Binding ShowDetails}" />
                                <MenuItem Header="Check files again" Command="{Binding RecheckSelectedCommand}" />
                                <MenuItem Header="Copy magnet link" Command="{Binding CopyMagnetSelectedCommand}" />
                                <Separator />
                                <MenuItem Header="Pause everything" Command="{Binding PauseAllCommand}" />
                                <MenuItem Header="Resume everything" Command="{Binding ResumeAllCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBox Grid.Column="2" x:Name="SearchBox" Classes="search" MaxWidth="260" MinWidth="150" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0"
                         Text="{Binding Search}" Watermark="Search transfers   Ctrl+F">
                    <TextBox.InnerLeftContent>
                        <c:StrokeIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="10,0,0,0" Foreground="{StaticResource TextFaintBrush}" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- Room for the window buttons Windows draws over the corner. -->
                <Panel Grid.Column="3" x:Name="CaptionSpace" Width="138" />
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Live speed and the slow mode switch, pinned to the bottom -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,14,16,14">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <c:StrokeIcon Data="{StaticResource IconDown}" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Classes="caption" Text="Download" />
                                </StackPanel>
                                <TextBlock Classes="num" FontSize="15" FontWeight="SemiBold" Text="{Binding DownRateText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <c:StrokeIcon Data="{StaticResource IconUp}" Width="12" Height="12" Foreground="{StaticResource UpBrush}" />
                                    <TextBlock Classes="caption" Text="Upload" />
                                </StackPanel>
                                <TextBlock Classes="num" FontSize="15" FontWeight="SemiBold" Text="{Binding UpRateText}" />
                            </StackPanel>
                        </Grid>
                        <c:Sparkline Height="44" History="{Binding History}" Version="{Binding HistoryVersion}" />
                        <TextBlock Classes="caption" Text="{Binding LimitText}" TextTrimming="CharacterEllipsis" />
                        <Border Classes="hairline" Margin="0,2" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Slow mode" FontSize="13" />
                                <TextBlock Classes="caption" Text="{Binding SlowText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SlowMode}" Margin="8,0,-10,0"
                                          AutomationProperties.Name="Slow mode" ToolTip.Tip="Switch to the slow mode limits, for when someone else needs the line" />
                        </Grid>
                    </StackPanel>
                </Border>

                <ScrollViewer>
                <StackPanel Margin="10,14,10,10" Spacing="2">
                    <TextBlock Classes="section" Text="TRANSFERS" Margin="10,0,0,4" />
                    <ListBox Classes="nav" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem" x:DataType="vm:NavItem">
                                <Setter Property="IsVisible" Value="{Binding IsShown}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <c:StrokeIcon Classes="navicon" Data="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"
                                                  Classes.danger="{Binding IsDanger}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="num faint" FontSize="12" Text="{Binding CountText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Classes="section" Text="TOOLS" Margin="10,18,0,4" />
                    <ListBox Classes="nav" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Grid ColumnDefinitions="Auto,*">
                                    <c:StrokeIcon Classes="navicon" Data="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Panel Grid.Row="1" Grid.Column="1">

            <!-- Transfers -->
            <Grid x:Name="TransfersGrid" IsVisible="{Binding IsTransfers}" RowDefinitions="Auto,Auto,*,Auto,260">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="20,14,20,10">
                    <TextBlock Classes="heading" FontSize="15" Text="{Binding ListTitle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="caption num" Margin="10,2,0,0" VerticalAlignment="Center"
                               Text="{Binding Rows.Count, StringFormat='{}{0} shown'}" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="{Binding SelectionText}" VerticalAlignment="Center" />
                </Grid>

                <!-- A magnet the user just copied -->
                <Border Grid.Row="1" Margin="20,0,20,10" Padding="12,0,6,0" Height="40" CornerRadius="{StaticResource PanelRadius}"
                        Background="{StaticResource AccentSoftBrush}" BorderBrush="#4A3820" BorderThickness="1"
                        IsVisible="{Binding ClipboardOffer, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <c:StrokeIcon Data="{StaticResource IconMagnet}" Foreground="{StaticResource AccentBrush}" Width="15" Height="15" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding ClipboardOfferText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Classes="accent" Height="28" Content="Add it" Command="{Binding AcceptClipboardCommand}" Margin="8,0,4,0" />
                        <Button Grid.Column="3" Classes="tool" Height="28" Content="Dismiss" Command="{Binding DismissClipboardCommand}" />
                    </Grid>
                </Border>

                <Panel Grid.Row="2">
                    <DataGrid x:Name="Table" SelectionMode="Extended" Margin="8,0,8,0" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Transfers">
                        <DataGrid.Styles>
                            <Style Selector="DataGridColumnHeader">
                                <Setter Property="ContextFlyout" Value="{DynamicResource ColumnsMenu}" />
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.KeyBindings>
                            <KeyBinding Gesture="Space" Command="{Binding TogglePauseSelectedCommand}" />
                        </DataGrid.KeyBindings>
                        <DataGrid.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="Resume" Command="{Binding ResumeSelectedCommand}" />
                                <MenuItem Header="Pause" Command="{Binding PauseSelectedCommand}" />
                                <MenuItem Header="Start now, skip the queue" Command="{Binding ForceStartSelectedCommand}" />
                                <MenuItem Header="Download in order" Command="{Binding ToggleSequentialCommand}" IsEnabled="{Binding ShowDetails}" />
                                <Separator />
                                <MenuItem Header="Open folder" Command="{Binding OpenFolderSelectedCommand}" />
                                <MenuItem Header="Move files to..." Command="{Binding MoveSelectedCommand}" IsEnabled="{Binding ShowDetails}" />
                                <MenuItem Header="Check files again" Command="{Binding RecheckSelectedCommand}" />
                                <MenuItem Header="Copy magnet link" Command="{Binding CopyMagnetSelectedCommand}" />
                                <Separator />
                                <MenuItem Header="Remove..." InputGesture="Delete" Classes="danger" Command="{Binding RemoveSelectedCommand}" />
                            </MenuFlyout>
                        </DataGrid.ContextFlyout>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" Tag="Name" Width="*" MinWidth="180" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TorrentRowViewModel">
                                        <Grid ColumnDefinitions="Auto,*" Margin="12,0">
                                            <c:StrokeIcon Data="{Binding StateIcon}" Foreground="{Binding StateBrush}" Width="15" Height="15" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Tag="Size" Width="84" SortMemberPath="SizeBytes">
                                <DataGridTemplateColumn.Header><TextBlock Text="Size" HorizontalAlignment="Right" /></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TorrentRowViewModel">
                                        <TextBlock Classes="num dim" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Progress" Tag="Progress" Width="140" SortMemberPath="Progress">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TorrentRowViewModel">
                                        <Grid ColumnDefinitions="*,46" Margin="12,0" VerticalAlignment="Center">
                                            <c:Meter Value="{Binding Progress}" Fill="{Binding MeterBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Classes="num dim" FontSize="12" Text="{Binding ProgressText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Tag="Status" Width="128" SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TorrentRowViewModel">
                                        <TextBlock Classes="dim" Classes.danger="{Binding IsError}" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ErrorText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Tag="Down" Width="88" SortMemberPath="DownRate">
                                <DataGridTemplateColumn.Header><TextBlock Text="Down" HorizontalAlignment="Right" /></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TorrentRowViewModel">
                                        <TextBlock Classes="num accent" Text="{Binding DownText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Tag="Up" Width="84" SortMemberPath="UpRate">
                                <DataGridTemplateColumn.Header><TextBlock Text="Up" HorizontalAlignment="Right" /></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TorrentRowViewModel">
                                        <TextBlock Classes="num up" Text="{Binding UpText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Tag="Time left" Width="92" SortMemberPath="EtaSeconds">
                                <DataGridTemplateColumn.Header><TextBlock Text="Time left" HorizontalAlignment="Right" /></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TorrentRowViewModel">
                                        <TextBlock Classes="num dim" Text="{Binding EtaText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Tag="Peers" Width="76" SortMemberPath="Peers">
                                <DataGridTemplateColumn.Header><TextBlock Text="Peers" HorizontalAlignment="Right" ToolTip.Tip="Seeds / peers connected" /></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TorrentRowViewModel">
                                        <TextBlock Classes="num dim" Text="{Binding PeersText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Tag="Ratio" Width="64" SortMemberPath="Ratio">
                                <DataGridTemplateColumn.Header><TextBlock Text="Ratio" HorizontalAlignment="Right" /></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TorrentRowViewModel">
                                        <TextBlock Classes="num dim" Text="{Binding RatioText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Added" Tag="Added" Width="124" SortMemberPath="Added">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TorrentRowViewModel">
                                        <TextBlock Classes="num faint" Text="{Binding AddedText}" VerticalAlignment="Center" Margin="12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- First run -->
                    <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="420" Margin="0,0,0,40">
                        <c:AppMark Width="56" Height="56" HorizontalAlignment="Center" />
                        <TextBlock Classes="title" Text="Add your first torrent" HorizontalAlignment="Center" />
                        <TextBlock Classes="dim" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Drop a .torrent file anywhere on this window, paste a magnet link, or pick one below." />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Classes="accent" Command="{Binding AddFilesCommand}" AutomationProperties.Name="Open a torrent file">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:StrokeIcon Data="{StaticResource IconFile}" Width="15" Height="15" />
                                    <TextBlock Text="Open torrent file" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddLinkCommand}" AutomationProperties.Name="Add a magnet link">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:StrokeIcon Data="{StaticResource IconMagnet}" Width="15" Height="15" />
                                    <TextBlock Text="Add magnet link" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Classes="caption" Text="Ctrl+O  open file" />
                            <TextBlock Classes="caption" Text="Ctrl+L  add link" />
                            <TextBlock Classes="caption" Text="Ctrl+V  paste" />
                        </StackPanel>
                    </StackPanel>

                    <Border IsVisible="{Binding ShowDropHint}" VerticalAlignment="Bottom" Margin="20,0,20,16" Height="96"
                            CornerRadius="{StaticResource PanelRadius}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Background="#08FFFFFF" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <c:StrokeIcon Data="{StaticResource IconDownload}" Width="20" Height="20" Foreground="{StaticResource TextFaintBrush}" />
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Classes="dim" Text="Drop a .torrent file here, or press Ctrl+V with a magnet link copied" />
                                <TextBlock Classes="caption" Text="Finished downloads are scanned for viruses before you open them." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel IsVisible="{Binding NothingMatches}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="0,0,0,40">
                        <TextBlock Classes="heading" Text="Nothing here" HorizontalAlignment="Center" />
                        <TextBlock Classes="caption" Text="No transfers match this view." HorizontalAlignment="Center" />
                    </StackPanel>
                </Panel>

                <GridSplitter Grid.Row="3" Height="5" ResizeDirection="Rows" IsVisible="{Binding ShowDetails}" Background="Transparent" />

                <!-- Details of the selected torrent -->
                <Border Grid.Row="4" x:Name="DetailsPanel" IsVisible="{Binding ShowDetails}" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                    <v:DetailsView />
                </Border>
            </Grid>

            <!-- Speed test and settings -->
            <Panel IsVisible="{Binding IsSpeedTest}">
                <v:SpeedTestView DataContext="{Binding SpeedTest}" />
            </Panel>
            <Panel IsVisible="{Binding IsSettings}">
                <v:SettingsView DataContext="{Binding Settings}" />
            </Panel>

            <!-- Drop target, while a file is dragged over the window -->
            <Border x:Name="DropOverlay" IsVisible="False" Margin="16" CornerRadius="{StaticResource PanelRadius}"
                    Background="#E60E0F11" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <c:StrokeIcon Data="{StaticResource IconDownload}" Width="36" Height="36" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Classes="title" Text="Drop to add" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="16,0">
                <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:StrokeIcon Data="{StaticResource IconWorld}" Width="13" Height="13" Foreground="{StaticResource TextFaintBrush}" />
                        <TextBlock Classes="caption num" Text="{Binding DhtText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:StrokeIcon Data="{StaticResource IconPlug}" Width="13" Height="13" Foreground="{StaticResource TextFaintBrush}" />
                        <TextBlock Classes="caption num" Text="{Binding PortText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:StrokeIcon Data="{StaticResource IconUsers}" Width="13" Height="13" Foreground="{StaticResource TextFaintBrush}" />
                        <TextBlock Classes="caption num" Text="{Binding ConnectionsText}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                    <Button Classes="tool" Height="22" Padding="8,0" Command="{Binding OpenUpdateCommand}"
                            IsVisible="{Binding UpdateText, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:StrokeIcon Data="{StaticResource IconDownload}" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Classes="accent" FontSize="12" Text="{Binding UpdateText}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Classes="caption num" Text="{Binding TotalsText}" />
                    <TextBlock Classes="caption num" Text="{Binding FreeText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shown over everything when the engine cannot start, or while quitting -->
        <Border x:Name="Curtain" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="False" Background="{StaticResource BgBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="520">
                <c:AppMark Width="48" Height="48" HorizontalAlignment="Center" />
                <TextBlock x:Name="CurtainTitle" Classes="title" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="CurtainText" Classes="dim" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
