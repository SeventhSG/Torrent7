<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Torrent7.ViewModels"
        xmlns:c="using:Torrent7.Controls"
        x:Class="Torrent7.Views.AddTorrentWindow"
        x:DataType="vm:AddTorrentViewModel"
        Title="Add torrent"
        Icon="avares://Torrent7/Assets/Torrent7.ico"
        Width="720" Height="600" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- What it is -->
        <StackPanel Grid.Row="0" Margin="24,20,24,0" Spacing="4">
            <TextBlock Classes="title" FontSize="17" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="dim num" Text="{Binding Summary}" />
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="6,1" IsVisible="{Binding IsPrivate}"
                        ToolTip.Tip="Its tracker keeps count of what you share. Torrent7 will not add other trackers to it.">
                    <TextBlock Classes="accent" FontSize="11" FontWeight="SemiBold" Text="PRIVATE" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Where it goes -->
        <Border Grid.Row="1" Margin="24,16,24,12" Classes="panel" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                <c:StrokeIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding SaveDir}" Margin="10,0" AutomationProperties.Name="Save in" />
                <Button Grid.Column="2" Content="Change..." Command="{Binding BrowseCommand}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="10,6,0,0" Classes="caption num" Classes.danger="{Binding SpaceShort}" Text="{Binding SpaceText}" />
            </Grid>
        </Border>

        <!-- The files, or the wait for them -->
        <Panel Grid.Row="2" Margin="24,0,24,0">
            <Border Classes="panel" IsVisible="{Binding !IsFetching}" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="12,6,6,6">
                        <TextBlock Classes="heading" Text="Files" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasFiles}">
                            <Button Classes="tool" Height="26" Content="Select all" Command="{Binding SelectAllCommand}">
                                <Button.CommandParameter><x:Boolean>True</x:Boolean></Button.CommandParameter>
                            </Button>
                            <Button Classes="tool" Height="26" Content="Select none" Command="{Binding SelectAllCommand}">
                                <Button.CommandParameter><x:Boolean>False</x:Boolean></Button.CommandParameter>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" Classes="compact" ItemsSource="{Binding Files}" SelectionMode="Single" CanUserReorderColumns="False"
                              HeadersVisibility="None" BorderBrush="{StaticResource LineBrush}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FileChoice">
                                        <CheckBox Classes="bare" IsChecked="{Binding Include}" HorizontalAlignment="Center" AutomationProperties.Name="Download this file" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FileChoice">
                                        <TextBlock Text="{Binding Path}" Margin="4,0,12,0" VerticalAlignment="Center" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FileChoice">
                                        <TextBlock Classes="num dim" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Classes="caption" Text="The file list arrives once the download starts." HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding NoFileList}" />
                </Grid>
            </Border>

            <Border Classes="panel" IsVisible="{Binding IsFetching}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="380">
                    <ProgressBar IsIndeterminate="True" Width="220" />
                    <TextBlock Classes="dim" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Asking peers for the file list. Popular torrents answer in seconds; rare ones can take a while." />
                    <Button HorizontalAlignment="Center" Content="Add without waiting" Command="{Binding AddWithoutWaitingCommand}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="{StaticResource ControlRadius}" Padding="12,10" VerticalAlignment="Top" Margin="0,8,0,0"
                    IsVisible="{Binding FetchError, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="danger" TextWrapping="Wrap" Text="{Binding FetchError}" />
            </Border>
        </Panel>

        <!-- How it starts -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="24,14,24,20">
            <CheckBox IsChecked="{Binding Start}" Content="Start right away" />
            <CheckBox Grid.Column="1" IsChecked="{Binding Sequential}" Content="Download in order" Margin="20,0,0,0"
                      ToolTip.Tip="Front to back, so video can play before it finishes. Slower when there are few seeds." />
            <Button Grid.Column="3" Classes="tool" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
            <Button Grid.Column="4" Classes="accent" Padding="18,0" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}" IsDefault="True"
                    AutomationProperties.Name="Add">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:StrokeIcon Data="{StaticResource IconDownload}" Width="15" Height="15" />
                    <TextBlock Text="Add" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
